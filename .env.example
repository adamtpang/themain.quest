# Finn AI agent (the in-app chatbot) calls Claude server-side.
# Get a key at https://console.anthropic.com/settings/keys
# Local dev: copy this file to .env.local and fill it in.
# Production: add ANTHROPIC_API_KEY in Vercel > Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=

# Private life command center authentication through Clerk.
# Use pk_test_/sk_test_ locally and pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/life
AUTH_ALLOWED_EMAIL=

# Local-only visual verification. Never enable this in production.
AUTH_DEV_BYPASS=false

# Optional local vault override. Defaults to %USERPROFILE%\ObsidianVault in development.
OBSIDIAN_VAULT_PATH=

# Shared command-center state uses the existing Neon key/value table.
DATABASE_URL=

# Local private agent bridge. Development only. Uses the signed-in Claude CLI
# subscription and never runs on Vercel. Set false to disable locally.
LIFE_LOCAL_AGENT_ENABLED=true
LIFE_LOCAL_AGENT_MODEL=sonnet
CLAUDE_CLI_PATH=
PROCESS_SKILL_PATH=
